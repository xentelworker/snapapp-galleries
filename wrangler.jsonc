{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snapapp-galleries",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snapapp-galleries",
      "database_id": "4f14401b-f63c-498e-ac09-93732047fabc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "snapapp-galleries"
    }
  ],
  "routes": [
    {
      "pattern": "gallery.snapapp.ca",
      "custom_domain": true
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://mjatifnaqbbxrfylflrx.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_33il9bepVxZe3o6a5f-Ajg_1P0itwmN",
    "ADMIN_USER_ID": "5dbda189-3470-4256-8e3f-9bc9b948c04b"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
